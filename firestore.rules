rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function myTeam() {
      return get(/databases/$(database)/documents/ms_profiles/$(request.auth.uid)).data.teamId;
    }
    function isMember(teamId) {
      return signedIn() && exists(/databases/$(database)/documents/ms_profiles/$(request.auth.uid)) && myTeam() == teamId;
    }

    match /ms_profiles/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // Join codes can be looked up one at a time (to join a team) but never listed.
    match /ms_joinCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.teamId is string;
    }
    match /ms_teams/{teamId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow get: if signedIn();
      allow update: if isMember(teamId);
      match /leads/{leadId} {
        allow read, update, delete: if isMember(teamId);
        allow create: if isMember(teamId) && request.resource.data.ownerUid == request.auth.uid;
      }
    }
  }
}
