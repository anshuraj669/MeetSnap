# ---------------------------------------------------------------
# Secrets and per-developer config: NEVER commit these
# ---------------------------------------------------------------
# Web: Firebase config, reCAPTCHA key and App Check debug token (copy .env.example instead)
.env
.env.*
!.env.example
*.local

# Android: Firebase config (download your own from the Firebase console)
google-services.json
# Android: SDK path + App Check debug token
local.properties
# Signing keys and their passwords
*.jks
*.keystore
*.p12
*.pem
keystore.properties
# Service accounts / admin credentials
service-account*.json
*-adminsdk-*.json
*credentials*.json

# ---------------------------------------------------------------
# Firebase CLI
# ---------------------------------------------------------------
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log

# ---------------------------------------------------------------
# Web build output and dependencies
# ---------------------------------------------------------------
node_modules/
dist/
dist-ssr/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------
# Android / Gradle build output (also in android/.gitignore)
# ---------------------------------------------------------------
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/app/release/
android/captures/
android/.cxx/
*.apk
*.aab
*.iml

